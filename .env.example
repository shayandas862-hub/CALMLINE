# CalmLine environment — copy to .env and fill in real values.
# .env is gitignored; never commit real keys. Placeholders use <angle brackets>.

# Supabase (your CalmLine project)
SUPABASE_URL=<your-calmline-supabase-project-url>
SUPABASE_SERVICE_KEY=<your-calmline-supabase-service-role-key>
# Direct Postgres connection string for the same project (asyncpg reads)
DATABASE_URL=<your-calmline-supabase-postgres-connection-string>

# Anthropic — agent and judge both run on Claude Opus 4.8
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-sonnet-5

# OpenAI — embeddings only (text-embedding-3-small, 1536-dim; see src/constants.py)
OPENAI_API_KEY=<your-openai-api-key>

# Cohere — reranker (rerank-v3.5) in the vendored retrieval pipeline
COHERE_API_KEY=<your-cohere-api-key>
