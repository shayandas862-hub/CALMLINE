# Secrets — never commit real credentials
.env
# backups and variants hold the same live keys as .env itself
.env.*
.env.local
.banned-words.local

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# OS
.DS_Store

# Working notes are deliberately local and never committed.
*.local.md
